{
  "name": "mascote-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "reset": "expo start --clear",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "test:watch": "vitest --pool=threads",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --pool=threads --coverage --reporter=default",
    "test:unit": "vitest run --pool=threads tests/lib- tests/content- tests/property- tests/store tests/lib/",
    "test:integration": "vitest run --pool=threads tests/services- tests/components- tests/hooks- tests/services/ tests/repositories/",
    "test:security": "vitest run --pool=threads tests/security/ tests/pentests.test.ts tests/safety.test.ts tests/lib-secureStore.test.ts tests/lib-memory.test.ts tests/lib-ml-embedding-openai.test.ts tests/content-billing.test.ts tests/lib-telemetry.test.ts tests/ai/production-guards.test.ts tests/lib/dna/persistence.test.ts tests/repositories/sync-local.test.ts",
    "test:pentest": "npm run test:security",
    "test:ai": "vitest run --pool=threads tests/ai/ tests/lib-ai tests/lib-ml",
    "test:game": "vitest run --pool=threads tests/game/",
    "test:subscription": "vitest run --pool=threads tests/content-billing tests/lib-paywall-triggers tests/services/subscription",
    "test:guarantees": "vitest run --pool=threads tests/guarantees/",
    "coverage:gaps": "node scripts/coverage-gaps.js",
    "test:e2e": "maestro test .maestro/",
    "test:e2e:critical": "maestro test --include-tags=critical .maestro/",
    "test:e2e:cloud": "maestro cloud .maestro/",
    "setup:e2e:win": "powershell -ExecutionPolicy Bypass -File scripts/setup-android-e2e-windows.ps1",
    "emulator:start": "powershell -ExecutionPolicy Bypass -File scripts/start-emulator.ps1",
    "test:e2e:win": "powershell -ExecutionPolicy Bypass -File scripts/run-e2e-windows.ps1",
    "doctor": "npx expo-doctor",
    "build-icons": "node scripts/build-icons.js",
    "audit:visual": "node scripts/audit-visual.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "quality": "npm run typecheck && npm run lint && npm test",
    "quality:ci": "npm run typecheck && npm run lint && npm run test:coverage"
  },
  "dependencies": {
    "@expo-google-fonts/instrument-serif": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/quicksand": "^0.4.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-three/drei": "^9.88.0",
    "@react-three/fiber": "^8.17.10",
    "expo": "~51.0.28",
    "expo-asset": "~10.0.10",
    "expo-av": "~14.0.7",
    "expo-blur": "~13.0.3",
    "expo-clipboard": "~6.0.3",
    "expo-constants": "~16.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-gl": "~14.0.2",
    "expo-haptics": "~13.0.1",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-modules-core": "~1.12.26",
    "expo-router": "~3.5.23",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "expo-system-ui": "~3.0.7",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-purchases": "^8.12.0",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-web": "~0.19.10",
    "three": "^0.166.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@eslint/js": "^8.57.1",
    "@react-native/eslint-config": "^0.74.89",
    "@testing-library/react-native": "^12.5.3",
    "@types/node": "^25.8.0",
    "@types/react": "~18.2.45",
    "@types/react-test-renderer": "^18.3.1",
    "@types/three": "^0.166.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^10.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "fast-check": "^3.23.2",
    "jsdom": "^25.0.1",
    "react-test-renderer": "18.2.0",
    "typescript": "~5.3.3",
    "vitest": "^4.1.6"
  },
  "private": true,
  "engines": {
    "node": ">=18 <=22"
  },
  "overrides": {
    "react-native": "0.74.5",
    "@react-native/virtualized-lists": "0.74.87"
  }
}
