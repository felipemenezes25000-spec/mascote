{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mascote.app/schemas/unity-mascot-state.v1.json",
  "title": "UnityMascotState",
  "type": "object",
  "required": [
    "schemaVersion",
    "identity",
    "progression",
    "state",
    "dna",
    "visuals",
    "morphology",
    "accessories",
    "mutations",
    "environment"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "identity": {
      "type": "object",
      "required": ["id", "name", "personality", "seed", "baseModel"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "personality": { "enum": ["calm", "motivator", "cute", "wise"] },
        "seed": { "type": "number" },
        "baseModel": { "type": "string" }
      }
    },
    "progression": {
      "type": "object",
      "required": ["phase", "level", "xp", "energy", "health"],
      "properties": {
        "phase": { "enum": ["egg", "baby", "child", "teen", "adult", "evolved"] },
        "level": { "type": "number", "minimum": 1 },
        "xp": { "type": "number", "minimum": 0 },
        "energy": { "type": "number" },
        "health": { "type": "number" },
        "streakDays": { "type": "number" }
      }
    },
    "state": {
      "type": "object",
      "required": ["mood", "animation", "reduceMotion", "lastSeenAt"],
      "properties": {
        "mood": { "enum": ["sad", "neutral", "happy", "excited", "exhausted"] },
        "animation": { "type": "object" },
        "reduceMotion": { "type": "boolean" },
        "lastSeenAt": { "type": "string", "format": "date-time" }
      }
    },
    "dna": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "visuals": { "type": "object" },
    "morphology": { "type": "object" },
    "accessories": { "type": "array" },
    "mutations": { "type": "array" },
    "environment": { "type": "object" },
    "pendingEvent": { "type": "object" }
  },
  "additionalProperties": false
}
