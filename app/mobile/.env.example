# Copie para .env na pasta app/mobile (não commitar .env com segredos reais).

# --- Ambiente ---
# development | production
EXPO_PUBLIC_ENV=development

# --- Billing (demo local por padrão) ---
# mock | revenuecat
EXPO_PUBLIC_BILLING_PROVIDER=mock

# RevenueCat — só quando for publicar com assinatura real
# EXPO_PUBLIC_REVENUECAT_API_KEY=appl_xxx
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_xxx
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_xxx
# EXPO_PUBLIC_RC_ENABLED=true

# SKUs (documentação; configurar no dashboard RevenueCat + lojas)
# EXPO_PUBLIC_RC_SKU_PLUS_MONTHLY=mascote_plus_monthly
# EXPO_PUBLIC_RC_SKU_PLUS_ANNUAL=mascote_plus_annual

# --- IA (proxy backend recomendado em produção — chave OpenAI só no servidor) ---
# EXPO_PUBLIC_AI_PROXY_URL=https://api.seudominio.com

# --- OpenAI (opcional; usuário também pode colar chave nas Configurações) ---
# EXPO_PUBLIC_OPENAI_API_KEY=sk-...

# --- Supabase (futuro sync; stub local até deploy) ---
# EXPO_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
