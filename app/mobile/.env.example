# Copie para .env na pasta app/mobile (não commitar .env com segredos reais).

# --- Ambiente ---
# development | production
EXPO_PUBLIC_ENV=development

# --- Billing (demo local por padrão) ---
# mock | revenuecat
EXPO_PUBLIC_BILLING_PROVIDER=mock

# RevenueCat — só quando for publicar com assinatura real
# EXPO_PUBLIC_REVENUECAT_API_KEY=appl_xxx
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_xxx
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_xxx
# EXPO_PUBLIC_RC_ENABLED=true

# SKUs (documentação; configurar no dashboard RevenueCat + lojas)
# EXPO_PUBLIC_RC_SKU_PLUS_MONTHLY=mascote_plus_monthly
# EXPO_PUBLIC_RC_SKU_PLUS_ANNUAL=mascote_plus_annual

# --- IA (proxy backend recomendado em produção — chave OpenAI só no servidor) ---
# Em produção (`EXPO_PUBLIC_ENV=production`), usar EXPO_PUBLIC_OPENAI_API_KEY
# está PROIBIDO pelo runtime-config (assertProductionConfig lança).
# Variáveis EXPO_PUBLIC_* viram literais no bundle JS — chave seria extraível
# do APK por qualquer um. Use UMA das duas alternativas:
#   1) Proxy backend (recomendado): EXPO_PUBLIC_AI_PROXY_URL aponta pro seu
#      servidor, e a chave fica só no backend.
#   2) Chave per-user: o app permite o usuário colar uma chave OpenAI dele
#      nas Configurações; ela vai pro expo-secure-store (Keychain/Encrypted
#      SharedPrefs), nunca pro bundle.
# EXPO_PUBLIC_AI_PROXY_URL=https://api.seudominio.com

# --- Unity mascote (Sprint 3 — opt-in) ---
# Home continua Three.js por padrão; /mascot-room usa Unity quando EXPO_PUBLIC_UNITY_ENABLED=true.
# EXPO_PUBLIC_MASCOT_RENDERER=three
# EXPO_PUBLIC_UNITY_ENABLED=true
# EXPO_PUBLIC_UNITY_HOME=true
# EXPO_PUBLIC_UNITY_QUALITY=auto
# EXPO_PUBLIC_UNITY_DEBUG_PANEL=true
# EXPO_PUBLIC_UNITY_SIMULATE_FAILURE=false
