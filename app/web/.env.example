# Copie para .env.local na pasta app/web (não commitar .env.local com segredos reais).

# --- Site ---
# URL canônica usada em metadata/OG/sitemap (lib/site.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Analytics (opcionais — desligados quando vazios) ---
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=mascote.app

# --- IA da demo do Mascote na landing (app/api/v1/mascot/reply) ---
# Server-side only: NUNCA prefixar com NEXT_PUBLIC_ (iria pro bundle do browser).
# Sem chave, a rota responde 503 proxy_not_configured (o mobile cai no fallback local).
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
